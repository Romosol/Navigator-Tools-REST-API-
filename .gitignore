logs/
public/logs/
*.log
results_log.txt
public/results_log.txt

# Microsoft Excel temporary lock files
~$*.xlsx
~$*.xls
*.tmp

# Environment variables & secrets
.env*
!.env.example

# Python cache and compiled artifacts
__pycache__/
public/__pycache__/
*.py[cod]
*$py.class
*.spec

# OS metadata
.DS_Store
Thumbs.db
coverage/
